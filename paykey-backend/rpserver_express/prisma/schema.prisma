generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  ADMIN
  USER
}

enum KeyStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// ==========================================
// 1. USER CORE
// ==========================================

model User {
  id           String  @id @default(uuid()) @db.VarChar(128)
  email        String  @unique
  fullName     String  @map("full_name")
  passwordHash String? @map("password_hash")
  role         Role    @default(USER)
  companyName  String? @map("company_name")
  mobile       String?

  // [PENTING] Field Balance untuk fitur Transaksi
  balance Decimal @default(0) @db.Decimal(15, 2)

  cifNumber String? @unique @map("cif_number") @db.VarChar(20)

  createdAt     DateTime @default(now()) @map("created_at")
  status        String   @default("active")
  suspendNote   String?  @map("suspend_note") @db.Text
  suspendReason String?  @map("suspend_reason") @db.Text

  // --- RELATIONS (Fix Error P1012 & Logic App) ---
  keys           UserKey[]
  authLogs       AuthLog[]
  knownDevices   UserKnownDevice[]
  knownLocations UserKnownLocation[]
  transactions   Transaction[]

  // Relasi ke Security Entities (Wajib ada)
  userDevices    UserDevice[]
  deviceKeys     AuthDeviceKey[]
  totpTokens     AuthTotpToken[]
  pushRequests   AuthPushRequest[]
  hardwareTokens TotpHardwareInventory[]

  @@map("users")
}

// ==========================================
// 2. JAVA SECURITY ENTITIES (SINKRONISASI)
// ==========================================

model UserKey {
  id                      BigInt    @id @default(autoincrement())
  aaguid                  String    @map("aaguid") @db.VarChar(36)
  attestationType         Int?      @map("attestation_type")
  credentialId            String    @unique @map("credential_id") @db.VarChar(256)
  publicKey               String    @map("public_key") @db.Text
  registeredTimestamp     DateTime? @default(now()) @map("registered_timestamp")
  signCounter             BigInt?   @map("sign_counter")
  signatureAlgorithm      Int?      @map("signature_algorithm")
  userDisplayName         String?   @map("user_display_name") @db.VarChar(64)
  userId                  String    @map("user_id") @db.VarChar(128)
  username                String?   @db.VarChar(64)
  deviceName              String?   @map("device_name")
  deviceTelemetry         Json?     @map("device_telemetry")
  lastActive              DateTime  @default(now()) @updatedAt @map("last_active")
  lastStatusChange        DateTime  @default(now()) @map("last_status_change")
  lastUsedIp              String?   @map("last_used_ip")
  status                  KeyStatus @default(ACTIVE)
  transports              String?
  rpEntityId              String?   @map("rp_entity_id") @db.VarChar(255)
  authenticated_timestamp DateTime? @db.DateTime(6)
  cred_protect            Int?
  rk                      Boolean?  @db.Bit(1)
  user_icon               String?   @db.VarChar(128)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_key")
}

model AuthDeviceKey {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  deviceId String @map("device_id")

  // SINKRONISASI JAVA (JANGAN DIHAPUS)
  publicKey     String  @map("public_key") @db.Text
  publicKeyHash String? @map("public_key_hash") @db.VarChar(64)
  algorithm     String? @db.VarChar(20)

  authType   String    @map("auth_type")
  status     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_device_keys")
}

model AuthTotpToken {
  id           String @id @default(uuid())
  serialNumber String @unique @map("serial_number")

  // SINKRONISASI JAVA (JANGAN DIHAPUS)
  encryptedSeed String   @map("encrypted_seed") @db.VarChar(512)
  timeStep      Int      @default(30) @map("time_step")
  digits        Int      @default(6)
  importedAt    DateTime @default(now()) @map("imported_at")

  userId     String?   @map("user_id")
  tokenType  String?   @map("token_type")
  status     String?
  assignedAt DateTime? @map("assigned_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("auth_totp_tokens")
}

// ==========================================
// INVENTORY MANAGEMENT (HARDWARE TOKENS)
// ==========================================
model TotpHardwareInventory {
  id           String @id @default(uuid())
  serialNumber String @unique @map("serial_number")
  status       String @default("available") // available, assigned, suspended, revoked, expired
  vendor       String @db.VarChar(50) // yubico, feitian, safenet
  batchId      String @map("batch_id") @db.VarChar(100)

  // Seed/Secret Key dari pabrik (Wajib dienkripsi AES-256 di database)
  secretKey  String   @map("secret_key") @db.VarChar(512)
  expiryDate DateTime @map("expiry_date")

  // Relasi ke User (Jika statusnya 'assigned')
  userId String? @map("user_id") @db.VarChar(128)
  user   User?   @relation(fields: [userId], references: [id])

  period      Int      @default(30)     // Menyimpan 30 atau 60 detik
  algorithm   String   @default("SHA1") // Menyimpan SHA1, SHA256, dll

  lastUsedAt DateTime? @map("last_used_at")
  assignedAt DateTime? @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([batchId])
  @@index([vendor])
  @@map("totp_hardware_inventory")
}

// ==========================================
// 3. NODE.JS / RISK / TRANSACTION ENTITIES
// ==========================================

model Transaction {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  amount    Decimal  @db.Decimal(15, 2)
  currency  String   @default("MYR")

  // [PENTING] Field Tambahan untuk Controller Transaksi Baru
  transactionNo String  @unique
  toAccount     String?
  description   String?
  type          String  @default("TRANSFER")
  status        String  @default("PENDING") // PENDING, SUCCESS, FAILED

  merchantName     String? @default("Unknown Merchant")
  merchantCategory String?
  merchantCountry  String?

  authMethod      String?
  authResult      String?
  ipAddress       String?
  locationCity    String?
  locationCountry String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  deviceInfo Json?
  riskLevel  String  @default("LOW")
  riskScore  Int?    @default(0)
  riskReason String? @db.Text

  appliedPolicyId String?
  appliedLimitId  String?

  riskAnalysisLogs RiskAnalysisLog[]

  @@index([userId])
  @@index([timestamp])
  @@map("transactions")
}

model RiskAnalysisLog {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  ruleCode         String
  scoreContributed Int

  createdAt DateTime @default(now())

  @@map("transaction_analysis_logs")
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  deviceId    String   @map("device_id")
  deviceModel String?
  fcmToken    String?  @map("fcm_token") @db.Text
  lastActive  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model ApiClient {
  id           String  @id @default(uuid())
  apiKey       String  @unique @map("api_key")
  apiSecret    String  @map("api_secret")
  name         String
  channel      String  @default("MOBILE") // Tambahkan @default
  consumerType String  @default("CONSUMER") @map("consumer_type") // Tambahkan @default
  isActive     Boolean @default(true)

  @@map("api_clients")
}

model AuthPushRequest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  status    String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("auth_push_requests")
}

model AuthLog {
  id            String   @id @default(uuid())
  email         String?
  userId        String?  @map("user_id")
  eventType     String   @map("event_type")
  authMethod    String?  @map("auth_method")
  status        String
  failureReason String?  @map("failure_reason")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  location      String?
  countryCode   String?  @map("country_code")
  device        String?
  isVpn         Boolean  @default(false) @map("is_vpn")
  riskScore     Int      @default(0) @map("risk_score")
  riskTags      Json?    @map("risk_tags")
  duration      Int?     @default(0)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("auth_logs")
}

// --- CONFIG TABLES ---

model AmountLimit {
  id        String   @id @default(uuid())
  segment   String
  currency  String   @default("MYR")
  minAmount Float    @default(0)
  maxAmount Float?
  weight    Int      @default(0)
  label     String   @default("low")
  stepUp    Boolean  @default(false)
  methods   Json?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("config_amount_limits")
}

model RiskThreshold {
  id        String   @id @default(uuid())
  segment   String   @default("consumer")
  lowScore  Int      @default(30)
  highScore Int      @default(70)
  updatedAt DateTime @updatedAt

  @@unique([segment])
  @@map("config_risk_thresholds")
}

model RiskRule {
  id         String   @id @default(uuid())
  segment    String   @default("consumer")
  ruleCode   String?
  ruleType   String? // Deprecated, use ruleCode
  name       String
  isActive   Boolean  @default(false)
  weight     Int      @default(0)
  parameters String?  @db.LongText
  updatedAt  DateTime @updatedAt

  @@unique([segment, ruleCode])
  @@map("config_risk_rules")
}

model AuthPolicy {
  id        String   @id @default(uuid())
  name      String?
  segment   String
  channel   String
  riskLevel String
  action    String   @default("LOGIN")
  condition String?  @db.LongText
  config    String?  @db.LongText
  priority  Int      @default(1)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([segment, channel, riskLevel, action], name: "policy_idx")
  @@map("config_auth_policies")
}

model PolicyAuditLog {
  id         String   @id @default(uuid())
  policyName String
  action     String
  adminEmail String
  changes    String   @db.LongText
  createdAt  DateTime @default(now())

  @@map("policy_audit_logs")
}

model UserKnownDevice {
  userId     String   @map("user_id") @db.VarChar(128)
  deviceHash String   @map("device_hash")
  lastSeen   DateTime @default(now()) @map("last_seen")
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, deviceHash])
  @@index([userId])
  @@map("user_known_devices")
}

model UserKnownLocation {
  userId      String   @map("user_id") @db.VarChar(128)
  countryCode String   @map("country_code")
  city        String
  lastSeen    DateTime @default(now()) @map("last_seen")
  user        User     @relation(fields: [userId], references: [id])

  @@id([userId, countryCode, city])
  @@index([userId])
  @@map("user_known_locations")
}

// --- FIDO METADATA ---

model authenticator_transport {
  id          BigInt @id @default(autoincrement())
  transport   String @db.VarChar(255)
  user_key_id BigInt

  @@index([user_key_id], map: "FKr5ng3evn4q5h581vo2ndet463")
}

model metadata {
  id                         BigInt  @id @default(autoincrement())
  aaguid                     String? @db.VarChar(255)
  biometric_status_reports   String? @db.LongText
  content                    String  @db.Text
  status_reports             String? @db.LongText
  time_of_last_status_change String? @db.VarChar(255)
}

model metadata_toc {
  id                           BigInt  @id @default(autoincrement())
  encoded_metadata_toc_payload String  @db.LongText
  legal_header                 String? @db.Text
  metadata_source              String  @db.Text
  next_update                  String  @db.VarChar(255)
  no                           BigInt
}

model metadata_yubico {
  id      Int    @id @default(autoincrement())
  content String @db.LongText
}

model rp {
  id          String  @id @db.VarChar(255)
  description String? @db.VarChar(255)
  icon        String? @db.VarChar(255)
  name        String  @db.VarChar(255)
}
